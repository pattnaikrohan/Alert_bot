# Settings for the server on Render, read automatically there (Render sets RENDER=true). No secrets here:
# keys and URLs (OPENROUTER_API_KEY, SNOWFLAKE_*, PA_CSDW_URL, ...) go in Render's Environment page, which
# also overrides anything in this file.

# start fresh: no demo or pre-set projects; each person's Azure resources are found when they sign in
ALERTBOT_CONFIG_DIR=./deploy/render-config
# the sign-in cache is in memory on Linux, so the worker runs inside the server to share it ("Live")
ALERTBOT_EMBEDDED_WORKER=true
ALERTBOT_TIMEZONE=UTC
