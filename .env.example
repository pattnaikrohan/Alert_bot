# Copy to .env and adjust. Every value here has a working default for the fake-data prototype.

# Metadata DB (bot results, incidents, users). Prototype: SQLite. Production: Azure SQL, e.g.
# mssql+pyodbc://@<server>.database.windows.net/alertbot?driver=ODBC+Driver+18+for+SQL+Server&Authentication=ActiveDirectoryMsi
ALERTBOT_DB_URL=sqlite:///./.data/alertbot.db

ALERTBOT_CONFIG_DIR=./config
# Timezone used for weekday baselines and the morning report.
ALERTBOT_TIMEZONE=UTC
# Public URL of the portal; used to build the deep links in alerts.
ALERTBOT_PORTAL_URL=http://localhost:5173

# Auth: "microsoft" = people sign in on the portal with their Microsoft account (device code + Authenticator).
# "entra" = MSAL in the browser against an app registration. ("dev" exists for automated tests only.)
ALERTBOT_AUTH_MODE=microsoft
ALERTBOT_ENTRA_TENANT_ID=
ALERTBOT_ENTRA_API_AUDIENCE=

# Key Vault used to resolve kv:// secret references in config (flow URLs, LLM key).
ALERTBOT_KEYVAULT_URL=

# ── Power Automate flow URLs ───────────────────────────────────────────────
# Referenced from config/projects/*.yaml as env://PA_SLIPSTREAM_URL etc.
# Leave empty to run in dry-run mode: alerts are built and stored, but not sent.
PA_SLIPSTREAM_URL=
PA_CSDW_URL=
