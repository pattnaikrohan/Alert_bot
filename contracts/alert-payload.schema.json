{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alert Bot → Power Automate payload",
  "description": "Body of every POST the bot makes to a project's flow. Paste the 'properties' block into the flow trigger's 'Request Body JSON Schema' to get dynamic content.",
  "type": "object",
  "required": ["schema_version", "event", "project", "incident_id", "severity", "title", "portal_url", "card"],
  "properties": {
    "schema_version": { "type": "string", "description": "Payload contract version, currently 1.0" },
    "event": { "type": "string", "enum": ["incident.opened", "incident.worsened", "incident.resolved", "report.morning", "test"] },
    "occurred_at": { "type": "string", "description": "ISO-8601 UTC" },
    "project": { "type": "string", "description": "Project key, e.g. slipstream; a shared flow switches on this" },
    "project_name": { "type": "string" },
    "incident_id": { "type": "integer", "description": "0 for report.morning and test (they are not about one incident)" },
    "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
    "status": { "type": "string", "enum": ["open", "acknowledged", "resolved"] },
    "title": { "type": "string" },
    "summary": { "type": "string", "description": "What happened, with the numbers" },
    "impact": { "type": "string" },
    "likely_cause": { "type": "string" },
    "action": { "type": "string", "description": "Suggested next step" },
    "confidence": { "type": "string", "enum": ["low", "medium", "high", ""] },
    "analysis_source": { "type": "string", "enum": ["rules", "ai"] },
    "checks": { "type": "array", "items": { "type": "string" } },
    "scope": { "type": "string", "description": "site:<name> or output:<id>" },
    "opened_at": { "type": ["string", "null"] },
    "resolved_at": { "type": ["string", "null"] },
    "portal_url": { "type": "string", "description": "Deep link to the incident in the portal" },
    "teams_channel": { "type": "string" },
    "email_owners": { "type": "boolean", "description": "True when this event should also be emailed (by default: critical opened/worsened)" },
    "owner_emails": { "type": "array", "items": { "type": "string" } },
    "report": { "type": "object", "description": "report.morning only: the full report data (status, per-pipeline and per-table figures)" },
    "card": { "type": "object", "description": "Ready-to-post Adaptive Card 1.5 for Teams" }
  }
}
