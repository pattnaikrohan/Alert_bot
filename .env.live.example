# LIVE setup (real CSDW Snowflake feeds + Microsoft sign-in with Authenticator).
# Copy to .env.live, fill in, then run any command with ALERTBOT_ENV_FILE=.env.live, e.g. in PowerShell:
#   $env:ALERTBOT_ENV_FILE = ".env.live"; uv run alertbot feeds-check
# Values here override .env, so the fake-data prototype keeps working without it.

ALERTBOT_CONFIG_DIR=./config-live
ALERTBOT_DB_URL=sqlite:///./.data/alertbot-live.db
ALERTBOT_TIMEZONE=UTC
ALERTBOT_PORTAL_URL=http://localhost:5173

# ── Microsoft sign-in (Entra ID) ────────────────────────────────────────────
# From scripts/setup-entra.ps1 (or the Azure portal app registrations).
ALERTBOT_AUTH_MODE=microsoft
ALERTBOT_ENTRA_TENANT_ID=
ALERTBOT_ENTRA_API_AUDIENCE=                 # the API app's client id (api://<id> also accepted)
# Reject any token that did not include a second factor (Microsoft Authenticator). Keep this on.
ALERTBOT_REQUIRE_MFA=true

# ── Snowflake (read-only) ───────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=                           # account identifier, e.g. abc12345.west-europe.azure
SNOWFLAKE_USER=                              # your Snowflake login name (data-quality checks + feeds); you sign in via SSO yourself

# ── AI (OpenRouter) ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=                          # never commit; rotate if it was ever shared

# ── Power Automate ──────────────────────────────────────────────────────────
# Empty = dry-run: alerts are built and shown in the portal but not sent.
PA_CSDW_URL=

# Alerts for projects found automatically (no flow_url of their own): a secret reference, e.g. env://PA_CSDW_URL
ALERTBOT_DEFAULT_FLOW_URL=
